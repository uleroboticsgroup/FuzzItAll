######################################################################
#
# FIA.config - Configuration file for FuzzItAll command line tool.
#
######################################################################


# FUZZITALL PROJECT VARIABLES
#---------------------------------------------------------------------

# File containing the fuzzing configuration of a project
FIA_PROJECT_CFG_FILE="fia_project.conf"

# Fuzzer output directory within a project
FIA_PROJECT_OUTPUT_DIR="fuzz-out"


# GENERAL SETTINGS
#---------------------------------------------------------------------

# Maximum number of parallel fuzzing tasks per project
FIA_MAX_PARALLEL_TASKS=1

# FuzzItAll command line tool root directory
FIA_ROOT=""

# FuzzItAll workspace for projects
FIA_WORKSPACE=""


# FUZZERS SETTINGS
#---------------------------------------------------------------------

# Directory where all available fuzzing engines are located
FIA_FUZZERS_DIRECTORY="${FIA_ROOT}fuzzers/"
