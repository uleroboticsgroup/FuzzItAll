######################################################################
#
#   FIA.config - Main configuration file for FuzzItAll.
#
######################################################################


# GENERAL SETTINGS
# --------------------------------------------------------------------

# Maximum number of secondary jobs
FIA_MAX_SECONDARY_JOBS=1

# Configuration file for target fuzzing projects
FIA_TARGET_CONFIG_FILE="conf.conf"

# File containing list of active jobs
FIA_ACTIVE_JOBS_FILE="jobs.lst"

# FuzzItAll root directory
FIA_ROOT=""


# SLURM PATHS
# --------------------------------------------------------------------

# Scratch space for storing temporary or large files
SCRATCH_DIRECTORY="/scratch/ule_dimia_1/${USER}/"

# Workspace for job results
FIA_WORKSPACE="${SCRATCH_DIRECTORY}fuzzitall/jobs/"


# FUZZERS
# --------------------------------------------------------------------

# Directory where all fuzzers are located
FUZZERS_DIRECTORY="${FIA_ROOT}fuzzers/"

# AFL++
AFLPP_ROOT="${FUZZERS_DIRECTORY}AFL++/regular/"
#AFLPP_ROOT="${FUZZERS_DIRECTORY}AFL++/sanitizers/"

# Default compiler wrapper
FIA_CC="${AFLPP_ROOT}afl-cc"
FIA_CXX="${AFLPP_ROOT}afl-cc"

# Default fuzzer
FIA_FUZZ="${AFLPP_ROOT}afl-fuzz"

# Default flags
#FIA_BUILD_FLAGS="AFL_USE_ASAN=1 AFL_USE_MSAN=1 AFL_USE_UBSAN=1 AFL_USE_CFISAN=1 AFL_USE_LSAN=1"
FIA_BUILD_FLAGS=""
FIA_FUZZ_FLAGS="AFL_PATH=${AFLPP_ROOT} AFL_NO_AFFINITY=1 AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1"